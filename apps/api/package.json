    "google-auth-library": "^9.14.2",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.20.0",
