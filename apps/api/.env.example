# ---- Server ----
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://reachinbox-web-nawz.onrender.com
FRONTEND_URL=https://reachinbox-web-nawz.onrender.com

# ---- Database ----
DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"
QUEUE_NAME=email-send

# ---- Scheduling / throughput (all configurable, nothing hardcoded) ----
# Worker concurrency: how many sends may run in parallel.
WORKER_CONCURRENCY=5
# Minimum gap between two individual sends, enforced queue-wide by the BullMQ limiter.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Default per-sender hourly cap. A campaign may override it with a lower value.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Attempts before a job is marked failed for good.
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=5000
# Re-add any DB rows missing from Redis on boot.
RECONCILE_ON_BOOT=true

# ---- Auth ----
# Must match the client ID used by the frontend, or ID token verification fails.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Set to false only for local Postman testing.
REQUIRE_AUTH=true

# ---- SMTP (Ethereal) ----
# Leave blank to auto-create throwaway Ethereal accounts on boot (creds are logged).
# Multiple senders: index them from 0 upward, they are upserted at boot.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587

SENDER_0_EMAIL=
SENDER_0_NAME=Outreach One
SENDER_0_USER=
SENDER_0_PASS=

SENDER_1_EMAIL=
SENDER_1_NAME=Outreach Two
SENDER_1_USER=
SENDER_1_PASS=
