# Backend base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth
AUTH_SECRET=run-`openssl rand -base64 32`-and-paste-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth -- console.cloud.google.com > Credentials > OAuth client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Must be the SAME client id the API verifies against (GOOGLE_CLIENT_ID in apps/api/.env)
